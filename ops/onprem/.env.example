# Configuración por-cliente de mkanban on-premises (mkanban.dev).
# Copiar a `.env` junto al docker-compose.yml y completar. Permisos: chmod 600.
# Los updates OTA nunca tocan este archivo.

# ── Registro de imágenes (credenciales entregadas por mdevel) ──────────────
# Token de solo lectura (scope read:packages). Si el token se revoca, la
# instancia sigue funcionando pero deja de recibir updates.
GHCR_USER=cliente-x
GHCR_TOKEN=

# Imagen y canal de updates. `stable` es el canal normal; mdevel puede
# indicar un canal distinto (p. ej. un rollout escalonado).
MK_IMAGE=ghcr.io/mdevel-uy/mkanban
MK_CHANNEL=stable

# ── Red ────────────────────────────────────────────────────────────────────
# Interfaz del host donde se publican los puertos. Por defecto loopback,
# porque el patrón esperado es un reverse proxy del host (Traefik/Caddy/Nginx)
# que termina TLS y hace forward a estos puertos. Cambiar a `0.0.0.0` solo si
# se expone directo en la interfaz pública (Docker publica por iptables y
# bypassea ufw — el reverse proxy sigue siendo lo recomendado).
MK_BIND_ADDR=127.0.0.1

# Puerto de la UI en el host y puerto del preview-proxy.
MK_PORT=3000
MK_PREVIEW_PORT=3009

# Si la UI se expone detrás de un dominio propio (reverse proxy del cliente),
# listar los orígenes permitidos separados por coma.
# MK_ALLOWED_ORIGINS=https://kanban.cliente.com

# ── Capacidad ───────────────────────────────────────────────────────────────
# Agentes de código concurrentes. Knob técnico según los recursos del servidor
# (no hay límite comercial); vacío = default de la app.
# WORKER_MAX_IN_REVIEW=

# CTA opcional que ve el usuario cuando una tarea queda encolada al llegar al cap.
# PLAN_UPGRADE_CTA_URL=mailto:sales@mdevel.dev
# PLAN_UPGRADE_CTA_LABEL=Aumentar capacidad

# ── Control plane (licencia + facturación) ─────────────────────────────────
# URL del control plane de mdevel y token de ingesta del cliente (entregados
# por mdevel en el alta). Con el token, la instancia queda vinculada y al día
# automáticamente; sin él, requiere aprobación manual de mdevel.
MKANBAN_CONTROL_PLANE_URL=https://control.mkanban.dev
MKANBAN_INGEST_TOKEN=

# ── Varios ──────────────────────────────────────────────────────────────────
RUST_LOG=info
