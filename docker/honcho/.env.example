# Honcho local para la memoria de Fluke (ver README.md).
# Copiar a src/.env y completar la key.

# Base de datos del compose de Honcho (postgres con pgvector).
DB_CONNECTION_URI=postgresql+psycopg://postgres:postgres@database:5432/postgres

# LLM y embeddings: por defecto todo va por OpenAI.
LLM_OPENAI_API_KEY=

# Uso personal, poco tráfico: procesar cada mensaje sin esperar a juntar un lote.
DERIVER_FLUSH_ENABLED=true

# Solo en la PC: sin auth (el compose expone el puerto únicamente en 127.0.0.1).
AUTH_USE_AUTH=false
