{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "mkanban",
  "version": "1.0.0",
  "identifier": "uy.mdevel.mkanban",
  "build": {
    "beforeDevCommand": {
      "script": "pnpm run tauri:before-dev",
      "cwd": "../.."
    },
    "devUrl": "http://localhost:3000",
    "frontendDist": "./splash"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' http://localhost:* ws://localhost:* http://127.0.0.1:* ws://127.0.0.1:*; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http://localhost:* http://127.0.0.1:*; connect-src 'self' http://localhost:* ws://localhost:* http://127.0.0.1:* ws://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "bundleName": "mkanban"
    },
    "windows": {},
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "AI-powered development workspace",
    "longDescription": "mkanban: Collaborative AI workspace for software development",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "macos-fps": {},
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERDNTM3MDM2MjRCODRDODYKUldTR1RMZ2tObkJUM0tTTkxYaEtxS0ZmVXBoakZRclFBVmlodmovUTE3a3pmWEJ6SUtQM1p4QlIK",
      "endpoints": [
        "https://github.com/mdevel-uy/mkanban/releases/download/desktop-latest/latest.json"
      ]
    }
  }
}
