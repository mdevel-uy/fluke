{
  "github": {
    "type": "http",
    "url": "https://api.githubcopilot.com/mcp/",
    "headers": {
      "Authorization": "Bearer YOUR_GITHUB_PAT"
    }
  },
  "context7": {
    "type": "http",
    "url": "https://mcp.context7.com/mcp",
    "headers": {
      "CONTEXT7_API_KEY": "YOUR_API_KEY"
    }
  },
  "playwright": {
    "command": "npx",
    "args": [
      "@playwright/mcp@latest"
    ]
  },
  "figma": {
    "type": "http",
    "url": "https://mcp.figma.com/mcp"
  },
  "sentry": {
    "type": "http",
    "url": "https://mcp.sentry.dev/mcp"
  },
  "atlassian": {
    "type": "http",
    "url": "https://mcp.atlassian.com/v1/mcp/authv2"
  },
  "aws_knowledge": {
    "type": "http",
    "url": "https://knowledge-mcp.global.api.aws"
  },
  "hostinger": {
    "command": "hostinger-api-mcp",
    "env": {
      "HOSTINGER_API_TOKEN": "YOUR_API_TOKEN"
    }
  },
  "grafana": {
    "command": "mcp-grafana",
    "env": {
      "GRAFANA_URL": "https://your-grafana-instance",
      "GRAFANA_SERVICE_ACCOUNT_TOKEN": "YOUR_TOKEN"
    }
  },
  "meta": {
    "github": {
      "name": "GitHub",
      "description": "Manage pull requests, issues, Actions and code search on GitHub",
      "url": "https://github.com/github/github-mcp-server"
    },
    "context7": {
      "name": "Context7",
      "description": "Fetch up-to-date documentation and code examples",
      "url": "https://github.com/upstash/context7",
      "icon": "mcp/context7logo.png"
    },
    "playwright": {
      "name": "Playwright",
      "description": "Browser automation with Playwright",
      "url": "https://github.com/microsoft/playwright-mcp",
      "icon": "mcp/playwright_logo_icon.svg"
    },
    "figma": {
      "name": "Figma",
      "description": "Turn Figma designs into code with the official Figma MCP server",
      "url": "https://developers.figma.com/docs/figma-mcp-server/"
    },
    "sentry": {
      "name": "Sentry",
      "description": "Access production errors, issues and traces from Sentry",
      "url": "https://docs.sentry.io/ai/mcp/"
    },
    "atlassian": {
      "name": "Atlassian",
      "description": "Connect Jira and Confluence knowledge via Atlassian's remote MCP server",
      "url": "https://support.atlassian.com/atlassian-rovo-mcp-server/docs/getting-started-with-the-atlassian-remote-mcp-server/"
    },
    "aws_knowledge": {
      "name": "AWS Knowledge",
      "description": "AWS documentation, API references and best practices — no credentials required",
      "url": "https://awslabs.github.io/mcp/servers/aws-knowledge-mcp-server"
    },
    "hostinger": {
      "name": "Hostinger",
      "description": "Manage Hostinger VPS, DNS, domains and hosting from the agent",
      "url": "https://github.com/hostinger/api-mcp-server"
    },
    "grafana": {
      "name": "Grafana",
      "description": "Query dashboards, metrics, logs and alerts from your Grafana instance",
      "url": "https://github.com/grafana/mcp-grafana"
    }
  }
}
